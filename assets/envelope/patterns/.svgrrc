{
  "replaceAttrValues": {
    "#1F2124": "{props.color || '#1F2124'}",
    "#888C91": "{props.color || '#888C91'}",
    "#505357": "{props.color || '#505357'}"
  },
  "svgoConfig": {
    "plugins": [
      {
        "name": "preset-default",
        "params": {
          "overrides": {
            "inlineStyles": { "onlyMatchedOnce": false },
            "removeViewBox": false,
            "removeUnknownsAndDefaults": false,
            "convertColors": false,
            "convertShapeToPath": { "convertArcs": true }
          }
        }
      }
    ]
  }
}
