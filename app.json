{
  "expo": {
    "name": "mongle_front_v2",
    "slug": "mongle_front_v2",
    "scheme": "mongle",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dongle.mongle",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.dongle.mongle"
    },
    "plugins": [
      "expo-audio",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash/splash_blank.png",
          "imageWidth": 1,
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/SUITX/SUITX-Regular.ttf",
            "./assets/fonts/SUITX/SUITX-SemiBold.ttf",
            "./assets/fonts/SUITX/SUITX-Bold.ttf",
            "./assets/fonts/Kyobo/KyoboHandwriting2025lyb.ttf",
            "./assets/fonts/KiwiMaru/KiwiMaru-Light.ttf"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "9e37a753-32b7-4ca4-a598-eecbabaed0c9"
      }
    },
    "owner": "enokimushroom"
  }
}
